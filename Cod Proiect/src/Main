package com.handwriting.gan;

import org.nd4j.linalg.dataset.api.iterator.DataSetIterator;
import org.nd4j.linalg.factory.Nd4j;

public class Main {
    public static void main(String[] args) throws Exception {
        System.out.println("=== Handwritten Digit Generation using GAN ===");
        DataSetIterator mnist = DataLoader.loadMNIST(128);
        GANModel gan = new GANModel();
        gan.train(mnist, 400); 
        System.out.println("Imagini generate salvate în folderul /output.");
        
        LatentSpaceVisualizer.visualize2D(
        	    Nd4j.randn(500, 2),
        	    Utils.oneHotRange(500, 10),
        	    "output/latent_space.png"
        	);
    }
}
